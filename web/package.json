{
  "name": "@bts/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-platform live-stream task scheduler web UI",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "naive-ui": "^2.40.4",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  }
}
