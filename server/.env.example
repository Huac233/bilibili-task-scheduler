# Copy this file to `.env` and fill in what you need.
#
# `.env` itself is never committed (see the root `.gitignore`); this file is, so
# that the settings below are discoverable rather than folklore. The server loads
# `server/.env` at startup — it is read relative to the working directory, which
# is this directory for both `pnpm dev` and `node dist/index.js`.

# Signs the browser session cookie.
#
# **Without it the server generates a random key per boot, so every restart
# invalidates every login.** That is the safe failure mode for a fresh checkout
# and the wrong one for anything you keep running: you would re-log-in after each
# restart and reasonably suspect the login is broken. Any random string of 16 or
# more characters will do.
SESSION_SECRET=

# SQLite file, relative to this directory.
# DB_PATH=data/app.sqlite

# PORT=8787
# HOST=0.0.0.0

# The built frontend this server serves. Build it with `pnpm build` at the repo root.
# WEB_DIST=../web/dist

# Request logging is off unless this is exactly "1".
# LOG_REQUESTS=1
