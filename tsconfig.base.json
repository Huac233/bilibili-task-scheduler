{
  "//": "Shared strict baseline. The goal is that `any` can never leak in:",
  "//1": "noImplicitAny covers the implicit cases, useUnknownInCatchVariables",
  "//2": "stops `catch (e)` from being any, and noUncheckedIndexedAccess forces",
  "//3": "indexing to yield T | undefined. Explicit `any` is banned by lint.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
